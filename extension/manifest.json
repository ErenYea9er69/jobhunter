{
  "manifest_version": 3,
  "name": "JobHunter",
  "version": "2.5.0",
  "description": "Fills job application forms from your resume on this computer. You review every answer and submit yourself.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1:8765/*", "http://localhost:8765/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "JobHunter",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "background": { "service_worker": "background.js" },
  "commands": {
    "toggle-panel": {
      "suggested_key": { "default": "Alt+Shift+J" },
      "description": "Open or close the JobHunter panel on this page"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.greenhouse.io/*", "https://boards.greenhouse.io/*", "https://job-boards.greenhouse.io/*",
        "https://*.lever.co/*", "https://*.ashbyhq.com/*", "https://*.myworkdayjobs.com/*",
        "https://*.workable.com/*", "https://apply.workable.com/*", "https://*.smartrecruiters.com/*",
        "https://*.bamboohr.com/*", "https://*.icims.com/*", "https://*.jobvite.com/*",
        "https://*.recruitee.com/*", "https://*.teamtailor.com/*", "https://*.breezy.hr/*",
        "https://*.personio.de/*", "https://*.personio.com/*", "https://*.taleo.net/*",
        "https://*.oraclecloud.com/*", "https://www.linkedin.com/*"
      ],
      "js": ["panel-styles.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
