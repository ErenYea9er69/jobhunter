{
  "manifest_version": 3,
  "name": "JobHunter AI Autofill & Copilot",
  "version": "2.3.0",
  "description": "1-click ATS application autofill, AI screening question solver, and verified application tracking powered by your local JobHunter engine.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "JobHunter Copilot"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["flyout.css"],
      "run_at": "document_idle"
    }
  ]
}
