# Copy to .env or set in your MCP client's "env" block. Nothing here is required.
JH_WORKSPACE=/path/to/workspace

# Optional job source
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=

# Tool list the AI sees: team (default, CEO tools only) or full (all tools)
JH_SURFACE=team

# Optional LLM wording for documents (leave empty to use the built-in engine)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
JH_AI_PROVIDER=auto

# Tuning
JH_SEARCH_DEADLINE=35
JH_COMPANY_BOARDS_PER_SEARCH=60
